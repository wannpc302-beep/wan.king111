-- แท็บเมนู (Tab Bar)
local TabBar = Instance.new("Frame", MainFrame)
TabBar.Size = UDim2.new(1, -20, 0, 35)
TabBar.Position = UDim2.new(0, 10, 0, 40)
TabBar.BackgroundTransparency = 1

local function createTabButton(name, pos)
    local btn = Instance.new("TextButton", TabBar)
    btn.Size = UDim2.new(0.32, 0, 1, 0)
    btn.Position = pos
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(80, 80, 90)
    btn.BackgroundColor3 = Color3.fromRGB(235, 235, 242)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    return btn
end

local tab1 = createTabButton("ตัวละคร", UDim2.new(0, 0, 0, 0))
local tab2 = createTabButton("การต่อสู้", UDim2.new(0.34, 0, 0, 0))
local tab3 = createTabButton("มองทะลุ", UDim2.new(0.68, 0, 0, 0))

-- คอนเทนต์แต่ละหน้า
local ContentFrame = Instance.new("ScrollingFrame", MainFrame)
ContentFrame.Size = UDim2.new(1, -20, 1, -90)
ContentFrame.Position = UDim2.new(0, 10, 0, 80)
ContentFrame.BackgroundTransparency = 1
ContentFrame.CanvasSize = UDim2.new(0, 0, 0, 300)

-- หน้าตัวละคร (Char Tab Content)
local CharContainer = Instance.new("Frame", ContentFrame)
CharContainer.Size = UDim2.new(1, 0, 1, 0)
CharContainer.BackgroundTransparency = 1

local function createToggle(parent, text, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, 0, 0, 35)
    frame.BackgroundTransparency = 1
    
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Text = text
    label.TextColor3 = Color3.fromRGB(50, 50, 60)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0, 40, 0, 22)
    btn.Position = UDim2.new(1, -40, 0.5, -11)
    btn.Text = ""
    btn.BackgroundColor3 = Color3.fromRGB(210, 210, 220)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    
    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.BackgroundColor3 = active and Color3.fromRGB(255, 80, 120) or Color3.fromRGB(210, 210, 220)
        callback(active)
    end)
end

-- Speed Toggle & Slider
local speedActive = false
local speedVal = 100

createToggle(CharContainer, "Speed Boost", function(state) speedActive = state end)

local SliderLabel = Instance.new("TextLabel", CharContainer)
SliderLabel.Size = UDim2.new(1, 0, 0, 25)
SliderLabel.Position = UDim2.new(0, 0, 0, 40)
SliderLabel.Text = "Speed Slider: " .. speedVal
SliderLabel.TextColor3 = Color3.fromRGB(50, 50, 60)
SliderLabel.BackgroundTransparency = 1
SliderLabel.Font = Enum.Font.GothamMedium
SliderLabel.TextSize = 12
SliderLabel.TextXAlignment = Enum.TextXAlignment.Left

local Bar = Instance.new("Frame", CharContainer)
Bar.Size = UDim2.new(1, 0, 0, 6)
Bar.Position = UDim2.new(0, 0, 0, 75)
Bar.BackgroundColor3 = Color3.fromRGB(220, 220, 230)
Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)

local Handler = Instance.new("TextButton", Bar)
Handler.Size = UDim2.new(0, 18, 0, 18)
Handler.Position = UDim2.new(0.5, -9, -0.5, 0)
Handler.BackgroundColor3 = Color3.fromRGB(255, 80, 120)
Handler.Text = ""
Instance.new("UICorner", Handler).CornerRadius = UDim.new(1, 0)

Handler.MouseButton1Down:Connect(function()
    local drag = true
    while drag and RunService.RenderStepped:Wait() do
        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then drag = false break end
        local mouse = UserInputService:GetMouseLocation()
        local percent = math.clamp((mouse.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        Handler.Position = UDim2.new(percent, -9, -0.5, 0)
        speedVal = math.floor(16 + (200 - 16) * percent)
        SliderLabel.Text = "Speed Slider: " .. speedVal
    end
end)

-- ฟังก์ชันอื่นๆ (Fullbright, Infinite Jump, Noclip)
local yOffset = 95
local function addExtraToggle(text, callback)
    local f = Instance.new("Frame", CharContainer)
    f.Size = UDim2.new(1, 0, 0, 35)
    f.Position = UDim2.new(0, 0, 0, yOffset)
    f.BackgroundTransparency = 1
    
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(0.7, 0, 1, 0)
    l.Text = text
    l.TextColor3 = Color3.fromRGB(50, 50, 60)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    
    local b = Instance.new("TextButton", f)
    b.Size = UDim2.new(0, 40, 0, 22)
    b.Position = UDim2.new(1, -40, 0.5, -11)
    b.Text = ""
    b.BackgroundColor3 = Color3.fromRGB(210, 210, 220)
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    
    local state = false
    b.MouseButton1Click:Connect(function()
        state = not state
        b.BackgroundColor3 = state and Color3.fromRGB(255, 80, 120) or Color3.fromRGB(210, 210, 220)
        callback(state)
    end)
    yOffset = yOffset + 40
end

addExtraToggle("Fullbright (สว่างตาแตก)", function(state)
    _G.Fullbright = state
end)

addExtraToggle("Infinite Jump (กระโดดรัว)", function(state)
    _G.InfJump = state
end)

addExtraToggle("Noclip (เดินทะลุ)", function(state)
    _G.Noclip = state
end)

-- เปิด/ปิด เมนูหลัก
ToggleBtn.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)

-- ลูปการทำงานระบบเกม
RunService.Stepped:Connect(function()
    pcall(function()
        if speedActive and localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
            localPlayer.Character.Humanoid.WalkSpeed = speedVal
        end
        if _G.Fullbright then
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.GlobalShadows = false
        end
        if _G.Noclip and localPlayer.Character then
            for _, v in pairs(localPlayer.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end)

UserInputService.JumpRequest:Connect(function()
    pcall(function()
        if _G.InfJump and localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid") then
            localPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end)
