-- SHARED OPTIMIZED RAYCAST & VISIBILITY
local sharedRaycastParams = RaycastParams.new()
sharedRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
sharedRaycastParams.IgnoreWater = true

local function isVisible(targetPart, character)
    if not targetPart or not targetPart.Parent or not character or not character:FindFirstChild("Head") then return false end
    local origin = character.Head.Position
    local direction = targetPart.Position - origin
    
    sharedRaycastParams.FilterDescendantsInstances = {character, Workspace.CurrentCamera}
    
    local result = Workspace:Raycast(origin, direction, sharedRaycastParams)
    if result then
        local hitPart = result.Instance
        if hitPart:IsDescendantOf(targetPart.Parent) then
            return true
        end
        return false
    end
    return true
end

-- SHARED TARGET FINDER
local function getBestTarget(fovRadius)
    local bestTarget = nil
    local shortestDist = math.huge
    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local viewportSize = camera.ViewportSize
    local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local myChar = localPlayer.Character

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            if AimbotTeamCheck and localPlayer.Team and p.Team and localPlayer.Team == p.Team then
                continue
            end

            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = p.Character:FindFirstChild(AimbotTargetPart)
            
            if hum and hum.Health > 0 and targetPart then
                if isVisible(targetPart, myChar) then
                    local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                        local dist = (screenPos2D - screenCenter).Magnitude
                        if dist <= fovRadius and dist < shortestDist then
                            shortestDist = dist
                            bestTarget = targetPart
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

-- 3. M-BOT 1
local MBot1Enabled = false
local FOV_RADIUS_1 = 120
local AimSmoothness = 0.25

local fovCircle1 = hasDrawing and Drawing.new("Circle") or nil
if fovCircle1 then
    fovCircle1.Visible = false
    fovCircle1.Radius = FOV_RADIUS_1
    fovCircle1.Color = Color3.fromRGB(255, 80, 140)
    fovCircle1.Thickness = 1.5
    fovCircle1.Filled = false
    fovCircle1.Transparency = 0.8
end

createToggle(Tabs["Combat"], "M-Bot 1 (Tracking + FOV)", "MBot1", function()
    if ToggleSetters["MBot2"] and ToggleSetters["MBot2"].Get() then
        ToggleSetters["MBot2"].Set(false)
    end

    MBot1Enabled = true
    if fovCircle1 then fovCircle1.Visible = true end
    disconnect("Feature_MBot1")
    Connections["Feature_MBot1"] = RunService.RenderStepped:Connect(function()
        if not MBot1Enabled then return end
        local camera = Workspace.CurrentCamera
        if not camera then return end
        local viewportSize = camera.ViewportSize
        if fovCircle1 then
            fovCircle1.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
        end

        local targetPart = getBestTarget(FOV_RADIUS_1)
        if targetPart then
            local targetCFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, AimSmoothness)
        end
    end)
end, function()
    MBot1Enabled = false
    if fovCircle1 then fovCircle1.Visible = false end
    disconnect("Feature_MBot1")
end)

-- 4. M-BOT 2
local MBot2Enabled = false
local FOV_RADIUS_2 = 150
local currentTarget2 = nil

local fovCircle2 = hasDrawing and Drawing.new("Circle") or nil
if fovCircle2 then
    fovCircle2.Visible = false
    fovCircle2.Radius = FOV_RADIUS_2
    fovCircle2.Color = Color3.fromRGB(0, 220, 255)
    fovCircle2.Thickness = 1.5
    fovCircle2.Filled = false
    fovCircle2.Transparency = 0.8
end

local snapLine = hasDrawing and Drawing.new("Line") or nil
if snapLine then
    snapLine.Visible = false
    snapLine.Color = Color3.fromRGB(255, 255, 255)
    snapLine.Thickness = 1.5
    snapLine.Transparency = 0.9
end

createToggle(Tabs["Combat"], "M-Bot 2 (Strict FOV + Snapline)", "MBot2", function()
    if ToggleSetters["MBot1"] and ToggleSetters["MBot1"].Get() then
        ToggleSetters["MBot1"].Set(false)
    end

    MBot2Enabled = true
    if fovCircle2 then fovCircle2.Visible = true end
    currentTarget2 = nil
    disconnect("Feature_MBot2")
    
    Connections["Feature_MBot2"] = RunService.RenderStepped:Connect(function()
        if not MBot2Enabled then return end
        local camera = Workspace.CurrentCamera
        if not camera then return end
        local viewportSize = camera.ViewportSize
        local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
        if fovCircle2 then fovCircle2.Position = screenCenter end

        local myChar = localPlayer.Character
        
        if currentTarget2 then
            local hum = currentTarget2.Parent and currentTarget2.Parent:FindFirstChildOfClass("Humanoid")
            local targetPart = currentTarget2
            if not hum or hum.Health <= 0 or not targetPart or not targetPart.Parent then
                currentTarget2 = nil
            else
                if AimbotTeamCheck and localPlayer.Team then
                    local p = Players:GetPlayerFromCharacter(currentTarget2.Parent)
                    if p and p.Team == localPlayer.Team then
                        currentTarget2 = nil
                    end
                end

                if currentTarget2 and not isVisible(currentTarget2, myChar) then
                    currentTarget2 = nil
                end

                if currentTarget2 then
                    local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                
