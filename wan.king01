local Connections = {}
local function disconnect(name)
    if Connections[name] then
        pcall(function() Connections[name]:Disconnect() end)
        Connections[name] = nil
    end
end

local function disconnectAll()
    for name, conn in pairs(Connections) do
        if conn then pcall(function() conn:Disconnect() end) end
        Connections[name] = nil
    end
end

local DRAG_THRESHOLD = 6

local function makeDraggable(handle, object, prefix, onClick)
    local dragging, dragStart, startPos, dragInput, hasMoved = false, nil, nil, nil, false
    Connections[prefix .. "_Began"] = handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, hasMoved, dragStart, startPos = true, false, input.Position, object.Position
            local endConn
            endConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not hasMoved and onClick then pcall(onClick) end
                    if endConn then endConn:Disconnect() end
                end
            end)
        end
    end)
    Connections[prefix .. "_Changed"] = handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    Connections[prefix .. "_UIS"] = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if not hasMoved then
                if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then
                    hasMoved = true
                end
            end
            if hasMoved then
                object.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end
    end)
end

makeDraggable(TitleBar, MainFrame, "DragMain")

local Tabs, TabButtons = {}, {}
local Names = {"Char", "Combat", "ESP", "FPS"}
local DisplayNames = {"ตัวละคร", "ต่อสู้", "ESP", "ภาพ/แสง"}

local function showTab(name)
    for tName, tab in pairs(Tabs) do tab.Visible = (tName == name) end
    for tName, btn in pairs(TabButtons) do
        if tName == name then
            btn.BackgroundColor3 = UI_ACTIVE
            btn.BackgroundTransparency = 0.02
        else
            btn.BackgroundColor3 = UI_TAB
            btn.BackgroundTransparency = 0.05
        end
    end
end

for i, name in ipairs(Names) do
    local tab = Instance.new("ScrollingFrame")
    tab.Name = name
    tab.Size = UDim2.new(1, 0, 1, 0)
    tab.BackgroundTransparency = 1
    tab.BorderSizePixel = 0
    tab.Visible = false
    tab.ScrollBarThickness = 3
    tab.AutomaticCanvasSize = Enum.AutomaticCanvasSize.Y
    tab.CanvasSize = UDim2.new(0, 0, 0, 0)
    tab.Parent = ContentContainer
    Tabs[name] = tab

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 8)
    list.HorizontalAlignment = Enum.HorizontalAlignment.Center
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = tab

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 8)
    pad.PaddingBottom = UDim.new(0, 8)
    pad.Parent = tab

    local btn = Instance.new("TextButton")
    btn.Name = name .. "TabButton"
    btn.Size = UDim2.new(0.24, 0, 1, 0)
    btn.Position = UDim2.new((i - 1) * 0.25, i == 1 and 4 or 0, 0, 0)
    if i > 1 then btn.Size = UDim2.new(0.24, 0, 1, 0) end
    btn.Text = DisplayNames[i]
    btn.TextColor3 = UI_TEXT
    btn.TextSize = 11
    btn.Font = Enum.Font.SourceSansBold
    btn.BackgroundColor3 = UI_TAB
    btn.BackgroundTransparency = 0.05
    btn.BorderSizePixel = 0
    btn.Parent = TabBar
    TabButtons[name] = btn

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    Connections["UI_Tab_" .. name] = btn.MouseButton1Click:Connect(function() showTab(name) end)
end

showTab("Char")

local ToggleSetters = {}

local function createToggle(parent, title, toggleName, onEnable, onDisable)
    local btn = Instance.new("TextButton")
    btn.Name = toggleName .. "Button"
    btn.Size = UDim2.new(0.92, 0, 0, 40)
    btn.Text = title
    btn.BackgroundColor3 = UI_BUTTON
    btn.BackgroundTransparency = 0.05
    btn.TextColor3 = UI_TEXT
    btn.TextSize = 13
    btn.Font = Enum.Font.SourceSansBold
    btn.BorderSizePixel = 0
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    local active = false
    local function setState(state)
        active = state
        if active then
            btn.BackgroundColor3 = UI_ACTIVE
            btn.BackgroundTransparency = 0.02
        else
            btn.BackgroundColor3 = UI_BUTTON
            btn.BackgroundTransparency = 0.05
        end
    end

    ToggleSetters[toggleName] = {
        Set = function(state)
            if active ~= state then
                setState(state)
                if state then
                    local ok, err = pcall(onEnable)
                    if not ok then
                        warn("Toggle On Error (" .. toggleName .. "): " .. tostring(err))
                        pcall(onDisable)
                        setState(false)
                    end
                else
                    local ok, err = pcall(onDisable)
                    if not ok then warn("Toggle Off Error (" .. toggleName .. "): " .. tostring(err)) end
                    setState(false)
                end
            end
        end,
        Get = function() return active end
    }

    Connections["UI_" .. toggleName .. "_Click"] = btn.MouseButton1Click:Connect(function()
        local target = not active
        setState(target)
        if target then
            local ok, err = pcall(onEnable)
            if not ok then
                warn("Toggle On Error (" .. toggleName .. "): " .. tostring(err))
                pcall(onDisable)
                setState(false)
            end
        else
            local ok, err = pcall(onDisable)
            if not ok then warn("Toggle Off Error (" .. toggleName .. "): " .. tostring(err)) end
            setState(false)
        end
    end)
    return { Button = btn, SetState = setState }
end

-- 1. SPEED
local OriginalWalkSpeed = setmetatable({}, { __mode = "k" })
local SpeedEnabled = false

local function saveWalkSpeed(char)
    if char and OriginalWalkSpeed[char] == nil then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then OriginalWalkSpeed[char] = hum.WalkSpeed end
    end
end

local function restoreWalkSpeed(char)
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and OriginalWalkSpeed[char] ~= nil then hum.WalkSpeed = OriginalWalkSpeed[char] end
        OriginalWalkSpeed[char] = nil
    end
end

createToggle(Tabs["Char"], "เพิ่มความเร็ว (Speed 50)", "Speed", function()
    SpeedEnabled = true
    disconnect("Feature_Speed")
    local char = localPlayer.Character
    if char then
        saveWalkSpeed(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 50 end
    end
    Connections["Feature_Speed"] = RunService.RenderStepped:Connect(function()
        if not SpeedEnabled then return end
        local char = localPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            saveWalkSpeed(char)
            if hum.WalkSpeed ~= 50 then hum.WalkSpeed = 50 end
        end
    end)
end, function()
    SpeedEnabled = false
    disconnect("Feature_Speed")
    if localPlayer.Character then restoreWalkSpeed(localPlayer.Character) end
end)

-- 2. NOCLIP
local OriginalCollision = setmetatable({}, { __mode = "k" })
local NoclipEnabled = false

local function saveCollision(part)
    if part and OriginalCollision[part] == nil then OriginalCollision[part] = part.CanCollide end
end

local function restoreCollision()
    for part, val in pairs(OriginalCollision) do
        if part and part.Parent then pcall(function() part.CanCollide = val end) end
    end
    table.clear(OriginalCollision)
end

local function applyNoclip(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            saveCollision(p)
            if p.CanCollide then p.CanCollide = false end
        end
    end
end

createToggle(Tabs["Combat"], "ทะลุกำแพง (Noclip)", "Noclip", function()
    NoclipEnabled = true
    disconnect("Feature_Noclip")
    if localPlayer.Character then applyNoclip(localPlayer.Character) end
    Connections["Feature_Noclip"] = RunService.Stepped:Connect(function()
        if NoclipEnabled and localPlayer.Character then applyNoclip(localPlayer.Character) end
    end)
end, function()
    NoclipEnabled = false
    disconnect("Feature_Noclip")
    restoreCollision()
end)

